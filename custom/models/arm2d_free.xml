<mujoco model="2d_arm_free">
    <option timestep="0.0005" gravity="0 0 -9.81"/>
    
    <worldbody>
        <light pos="0 0 3" dir="0 0 -1"/>
        <geom type="plane" size="10 10 0.1" rgba="0.9 0.9 0.9 1"/>

        <!-- Root base attached directly to the ground at Z = 0 -->
        <body name="base" pos="0 0 0">
            <geom type="cylinder" size="0.05 0.05" rgba="0.3 0.3 0.3 1"/>
            
            <!-- Link 1 (Rotates around Y-axis) -->
            <body name="link1" pos="0 0 0">
                <joint name="joint1" type="hinge" axis="0 1 0" pos="0 0 0"/>
                <geom type="capsule" fromto="0 0 0 0 0 0.4" size="0.03" rgba="0 0.7 0 1"/>
                
                <!-- Link 2 (Rotates around Y-axis) -->
                <body name="link2" pos="0 0 0.4">
                    <joint name="joint2" type="hinge" axis="0 1 0" pos="0 0 0"/>
                    <geom type="capsule" fromto="0 0 0 0 0 0.3" size="0.025" rgba="0 0 0.7 1"/>
                </body>

                <!-- Link 3 (Rotates around Y-axis) this is a second rotating arm and completely optional -->
                <body name="link3" pos="0 0 0.4">
                    <joint name="joint3" type="hinge" axis="0 1 0" pos="0 0 0"/>
                    <geom type="capsule" fromto="0 0 0 0 0 0.3" size="0.025" rgba="0.7 0 0.0 1"/>
                </body>

            </body>
        </body>
    </worldbody>
</mujoco>
