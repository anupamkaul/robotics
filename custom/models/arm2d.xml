<mujoco model="2d_arm">
    <option timestep="0.001" gravity="0 0 -9.81"/>
    
    <worldbody>
        <light pos="0 0 3"/>
        <!-- Fixed base pillar -->
        <body name="base" pos="0 0 1">
            <geom type="cylinder" size="0.05 0.1" rgba="0.5 0.5 0.5 1"/>
            
            <!-- Link 1 -->
            <body name="link1" pos="0 0 0">
                <joint name="joint1" type="hinge" axis="0 1 0"/>
                <geom type="capsule" fromto="0 0 0 0 0 -0.4" size="0.03" rgba="0 0.7 0 1"/>
                
                <!-- Link 2 -->
                <body name="link2" pos="0 0 -0.4">
                    <joint name="joint2" type="hinge" axis="0 1 0"/>
                    <geom type="capsule" fromto="0 0 0 0 0 -0.3" size="0.025" rgba="0 0 0.7 1"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <position name="servo1" joint="joint1" kp="100" kv="10"/>
        <position name="servo2" joint="joint2" kp="50" kv="5"/>
    </actuator>
</mujoco>
