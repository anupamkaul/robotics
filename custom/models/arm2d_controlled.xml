<mujoco model="2d_arm_controlled">
    <option timestep="0.0005" gravity="0 0 -9.81"/>
    
    <worldbody>
        <light pos="0 0 3" dir="0 0 -1"/>
        <geom type="plane" size="10 10 0.1" rgba="0.9 0.9 0.9 1"/>

        <body name="base" pos="0 0 0">
            <geom type="cylinder" size="0.05 0.05" rgba="0.3 0.3 0.3 1"/>
            
            <body name="link1" pos="0 0 0">
                <joint name="joint1" type="hinge" axis="0 1 0" pos="0 0 0"/>
                <geom type="capsule" fromto="0 0 0 0 0 0.4" size="0.03" rgba="0 0.7 0 1"/>
                
                <body name="link2" pos="0 0 0.4">
                    <joint name="joint2" type="hinge" axis="0 1 0" pos="0 0 0"/>
                    <geom type="capsule" fromto="0 0 0 0 0 0.3" size="0.025" rgba="0 0 0.7 1"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <!-- Standard position servos where d->ctrl directly commands the desired angle in Radians -->
        <position name="servo1" joint="joint1" kp="200" kv="20"/>
        <position name="servo2" joint="joint2" kp="200" kv="20"/>
    </actuator>
</mujoco>
